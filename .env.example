# ── 이 파일을 복사해서 ".env" 파일로 만들고 값을 채우세요 ──
#   cp .env.example .env
# .env 는 절대 git 에 커밋하지 마세요! (이미 .gitignore 에 등록됨)

# 사용할 LLM 제공자: openai 또는 gemini
LLM_PROVIDER=openai

# ▼▼▼ 여기에 본인 API 키를 붙여넣으세요 (브라우저엔 절대 안 나갑니다) ▼▼▼
LLM_API_KEY=여기에_비밀_키_붙여넣기

# 모델 (선택). 비워두면 provider 기본값 사용
#   openai 예: gpt-4o-mini   /   gemini 예: gemini-1.5-flash
LLM_MODEL=gpt-4o-mini

# 서버 포트 (기존 localhost:8123 와 동일하게 유지)
PORT=8123
